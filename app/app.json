{
  "expo": {
    "name": "Lola",
    "slug": "lola",
    "version": "0.10.0",
    "orientation": "portrait",
    "icon": "./assets/launcher/Icon-1024.png",
    "userInterfaceStyle": "dark",
    "extra": {
      "primaryLocale": "es-AR",
      "eas": {
        "projectId": "5fbc0ec9-e9de-448c-afdd-240628971e47"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.carlosbernardi.lola",
      "buildNumber": "2",
      "icon": "./assets/launcher/Icon-1024.png"
    },
    "android": {
      "package": "com.carlosbernardi.lola",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#1A73E8",
        "foregroundImage": "./assets/launcher/ic_launcher_foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "crbernardi",
    "plugins": [
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C0D0F",
          "image": "./assets/launcher/splash-logo.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#0C0D0F",
            "image": "./assets/launcher/splash-logo.png",
            "imageWidth": 200
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Lola necesita ver para ayudarte."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Lola necesita escucharte para responder.",
          "speechRecognitionPermission": "Lola usa el reconocimiento de voz para entenderte."
        }
      ],
      [
        "expo-quick-actions",
        {
          "androidIcons": {
            "shortcut_setup": {
              "foregroundImage": "./assets/launcher/ic_launcher_foreground.png",
              "backgroundColor": "#1A73E8"
            }
          },
          "iosActions": [
            {
              "id": "setup",
              "title": "Configuración",
              "subtitle": "Para el cuidador",
              "icon": "symbol:gearshape"
            }
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 31
          },
          "ios": {
            "buildReactNativeFromSource": true,
            "deploymentTarget": "17.0"
          }
        }
      ],
      "expo-audio"
    ]
  }
}
