{
  "$meta": {
    "name": "Lola Design Tokens",
    "version": "1.0.0",
    "description": "Code-ready tokens for the Lola assistive-vision app (React Native + Expo). Two surfaces: 'dad' (low-vision, Spanish, AAA contrast, huge targets) and 'caregiver' (normal density, English). All colors are hex, all sizes numeric on a 4-based scale, shadows split per platform.",
    "platform": "react-native-expo"
  },

  "color": {
    "primary": {
      "50":  "#EAF2FE",
      "100": "#D2E3FC",
      "200": "#A9C7F7",
      "500": "#1A73E8",
      "600": "#1565D8",
      "700": "#1557B0",
      "disabled": "#C2CAD6"
    },
    "neutral": {
      "white":  "#FFFFFF",
      "canvas": "#F6F7F9",
      "sunken": "#EDF0F4",
      "border": "#E0E4EA",
      "300":    "#CBD2DB",
      "ink":    "#0C0D0F"
    },
    "text": {
      "high":    "#1B1E24",
      "medium":  "#5C6470",
      "low":     "#8A929E",
      "onPrimary": "#FFFFFF",
      "onDark":  "#FFFFFF",
      "link":    "#1A73E8"
    },
    "status": {
      "success":   "#1E9E5A",
      "successBg": "#E6F6EC",
      "warn":      "#B9740A",
      "warnBg":    "#FCF1DD",
      "error":     "#D92D20",
      "errorPressed": "#B42318",
      "errorBg":   "#FDECEA"
    },
    "camera": {
      "scrim":        "rgba(0,0,0,0.55)",
      "scrimStrong":  "rgba(0,0,0,0.78)",
      "chrome":       "#000000",
      "overlayText":  "#FFFFFF",
      "shutterRing":  "#FFFFFF",
      "shutterFill":  "#FFFFFF"
    },
    "dad": {
      "describeBg": "#FFFFFF",
      "describeFg": "#0C0D0F",
      "describeAccent": "#1A73E8",
      "askBg": "#0C0D0F",
      "askFg": "#FFFFFF",
      "askAccent": "#5AA2F5",
      "listeningBg": "#0B3D8C",
      "speakingBg": "#0C0D0F",
      "errorBg": "#7A1610",
      "cancelHint": "#FFFFFF"
    }
  },

  "contrast": {
    "$note": "WCAG ratios for the dad-facing surface. All pairings target AAA (>=7:1 normal, >=4.5:1 large).",
    "describeFg_on_describeBg": 20.4,
    "askFg_on_askBg": 20.4,
    "overlayText_on_scrim": 12.1
  },

  "space": { "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64, "20": 80 },

  "radius": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 20, "2xl": 28, "pill": 999 },

  "type": {
    "family": {
      "brand": "PlusJakartaSans",
      "brandFallback": "System",
      "mono": "JetBrainsMono",
      "monoFallback": "monospace"
    },
    "weight": { "light": 300, "regular": 400, "medium": 500, "semibold": 600, "bold": 700, "extrabold": 800 },
    "caregiver": {
      "displayLight":  { "size": 34, "lineHeight": 40, "weight": 300, "tracking": -0.5 },
      "displayBold":   { "size": 34, "lineHeight": 40, "weight": 800, "tracking": -0.5 },
      "h1":            { "size": 28, "lineHeight": 34, "weight": 700, "tracking": -0.3 },
      "h2":            { "size": 22, "lineHeight": 28, "weight": 700, "tracking": -0.2 },
      "title":         { "size": 18, "lineHeight": 24, "weight": 700 },
      "body":          { "size": 16, "lineHeight": 24, "weight": 400 },
      "bodyMedium":    { "size": 16, "lineHeight": 24, "weight": 500 },
      "bodySmall":     { "size": 14, "lineHeight": 20, "weight": 400 },
      "caption":       { "size": 13, "lineHeight": 18, "weight": 500 },
      "monoHint":      { "size": 13, "lineHeight": 18, "weight": 400, "family": "JetBrainsMono" }
    },
    "dad": {
      "$note": "Minimum 24pt anywhere on the dad surface.",
      "actionLabel":   { "size": 44, "lineHeight": 48, "weight": 800, "tracking": -0.5 },
      "spoken":        { "size": 28, "lineHeight": 38, "weight": 600 },
      "statusLabel":   { "size": 26, "lineHeight": 32, "weight": 700 },
      "cancelHint":    { "size": 24, "lineHeight": 30, "weight": 600 }
    }
  },

  "shadow": {
    "$note": "iOS uses shadow* props; Android uses elevation. Apply the matching set per Platform.OS.",
    "sm": {
      "ios": { "shadowColor": "#0C0D0F", "shadowOffset": { "width": 0, "height": 1 }, "shadowOpacity": 0.06, "shadowRadius": 3 },
      "android": { "elevation": 1 }
    },
    "md": {
      "ios": { "shadowColor": "#0C0D0F", "shadowOffset": { "width": 0, "height": 4 }, "shadowOpacity": 0.08, "shadowRadius": 12 },
      "android": { "elevation": 3 }
    },
    "lg": {
      "ios": { "shadowColor": "#0C0D0F", "shadowOffset": { "width": 0, "height": 8 }, "shadowOpacity": 0.10, "shadowRadius": 24 },
      "android": { "elevation": 6 }
    },
    "sheet": {
      "ios": { "shadowColor": "#0C0D0F", "shadowOffset": { "width": 0, "height": -4 }, "shadowOpacity": 0.12, "shadowRadius": 28 },
      "android": { "elevation": 12 }
    }
  },

  "touchTarget": {
    "$note": "Minimum hit-area height in points.",
    "caregiverMin": 56,
    "dadMin": 88,
    "iconButton": 48
  },

  "motion": {
    "duration": { "instant": 0, "fast": 120, "base": 200, "slow": 320, "deliberate": 500, "longPress": 5000 },
    "easing": {
      "standard":   { "type": "cubic-bezier", "value": [0.2, 0, 0, 1] },
      "decelerate": { "type": "cubic-bezier", "value": [0, 0, 0, 1] },
      "accelerate": { "type": "cubic-bezier", "value": [0.3, 0, 1, 1] },
      "spring":     { "type": "spring", "damping": 18, "stiffness": 220, "mass": 1 }
    }
  },

  "icon": {
    "set": "Ionicons",
    "package": "@expo/vector-icons",
    "strokeStyle": "outline-default-filled-on-active",
    "sizes": { "sm": 20, "md": 24, "lg": 28, "dadXl": 96 },
    "names": {
      "describe": "camera-outline",
      "ask": "mic-outline",
      "listening": "radio-outline",
      "speaking": "volume-high-outline",
      "cancel": "close",
      "settings": "settings-outline",
      "add": "add",
      "edit": "create-outline",
      "delete": "trash-outline",
      "objects": "cube-outline",
      "rooms": "home-outline",
      "photo": "camera",
      "back": "chevron-back",
      "forward": "arrow-forward",
      "check": "checkmark",
      "retake": "refresh",
      "error": "alert-circle-outline",
      "lastSeen": "time-outline"
    }
  },

  "launcherIcon": {
    "android": {
      "backgroundColor": "#1A73E8",
      "foreground": "ic_launcher_foreground.png (432x432, lens mark centered in 264x264 safe zone)",
      "legacyDensities": [48, 72, 96, 144, 192]
    },
    "ios": { "master": "Icon-1024.png (1024x1024, no transparency, no rounded corners)", "backgroundColor": "#1A73E8" },
    "splash": { "image": "splash-logo.png (1242x2436 max, transparent)", "backgroundColor": "#0C0D0F" }
  }
}
